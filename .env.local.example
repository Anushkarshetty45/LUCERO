# LUCERO - Local Development Environment Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ====================
# SUPABASE CREDENTIALS
# ====================
REACT_APP_SUPABASE_URL=your-project-url-here
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# ====================
# AI/ML API KEYS
# ====================
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your-gemini-api-key-here

# ====================
# APPLICATION CONFIG
# ====================
REACT_APP_URL=http://localhost:3000
REACT_APP_ENVIRONMENT=development

# ====================
# FEATURE FLAGS
# ====================
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false
REACT_APP_ENABLE_DEBUG_MODE=true

# ====================
# SECURITY CONFIG
# ====================
REACT_APP_MAX_FILE_SIZE_MB=10
REACT_APP_ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
REACT_APP_SESSION_TIMEOUT_MINUTES=60

# ====================
# RATE LIMITING
# ====================
REACT_APP_API_RATE_LIMIT_PER_MINUTE=60
REACT_APP_AUTH_RATE_LIMIT_PER_HOUR=10
