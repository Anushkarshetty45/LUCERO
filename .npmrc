# NPM Configuration for LUCERO
# Security and package management settings

# Always save exact versions (prevent unexpected updates)
save-exact=true

# Audit level for security vulnerabilities
audit-level=moderate

# Prevent installing packages without package-lock.json
package-lock=true

# Only use registry over HTTPS
strict-ssl=true

# Log level
loglevel=warn

# Engine strict - enforce node/npm versions
engine-strict=true

# Disable package metadata (privacy)
send-metrics=false

# Prevent executing arbitrary scripts
ignore-scripts=false

# Fund messages
fund=false

# Update notifier
update-notifier=false
