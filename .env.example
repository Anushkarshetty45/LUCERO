# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Application URL
REACT_APP_URL=http://localhost:3000

# Google Gemini API (PDF analysis, quizzes, flashcards, mind maps)
REACT_APP_GEMINI_API_KEY=your-gemini-api-key

# Stripe (payments)
# Get from https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get price IDs from https://dashboard.stripe.com/products after creating your products
REACT_APP_STRIPE_PRO_MONTHLY_PRICE_ID=price_...
REACT_APP_STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Backend proxy server URL
REACT_APP_SERVER_URL=http://localhost:3002

# Email Service Configuration
# Choose ONE email service and add your API key below:

# Option 1: Resend (Recommended - Simple and free tier available)
# Sign up at https://resend.com and get your API key from the dashboard
# This key will be added to Supabase secrets (NOT in this .env file)
# RESEND_API_KEY=re_123abc... (DO NOT PUT THIS HERE - See setup guide)

# Option 2: SendGrid (Alternative)
# Sign up at https://sendgrid.com and get your API key
# This key will be added to Supabase secrets (NOT in this .env file)
# SENDGRID_API_KEY=SG.123abc... (DO NOT PUT THIS HERE - See setup guide)
