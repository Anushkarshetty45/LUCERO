# Git attributes for LUCERO
# Security and file handling

# Prevent sensitive files from being committed (additional layer)
.env filter=secret
.env.* filter=secret
*.key filter=secret
*.pem filter=secret
*.p12 filter=secret
credentials.json filter=secret

# Ensure line endings are consistent
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archive files
*.zip binary
*.tar binary
*.gz binary

# Diff settings
*.lock linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
