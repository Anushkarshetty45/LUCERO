# LUCERO - Production Environment Template
# These are the environment variables needed for production deployment

# ====================
# SUPABASE (REQUIRED)
# ====================
REACT_APP_SUPABASE_URL=https://your-production-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-production-anon-key

# ====================
# AI/ML API KEYS (REQUIRED)
# ====================
REACT_APP_GEMINI_API_KEY=your-production-gemini-key

# ====================
# APPLICATION CONFIG
# ====================
REACT_APP_URL=https://your-production-domain.com
REACT_APP_ENVIRONMENT=production

# ====================
# FEATURE FLAGS
# ====================
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_ENABLE_DEBUG_MODE=false

# ====================
# SECURITY CONFIG
# ====================
REACT_APP_MAX_FILE_SIZE_MB=10
REACT_APP_ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
REACT_APP_SESSION_TIMEOUT_MINUTES=60

# ====================
# PERFORMANCE
# ====================
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# ====================
# MONITORING (Optional)
# ====================
# REACT_APP_SENTRY_DSN=your-sentry-dsn
# REACT_APP_ANALYTICS_ID=your-analytics-id
